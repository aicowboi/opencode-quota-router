{
  "name": "opencode-quota-router",
  "version": "0.1.0",
  "description": "OpenCode plugin: automatic model fallback when you hit Claude, ChatGPT, Copilot or Grok usage limits, recovery when they reset, and a local usage and cost dashboard",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./engine": "./src/engine/index.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "bin": {
    "quota-router": "dist/cli.mjs"
  },
  "files": [
    "src",
    "gui",
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build && vite build -c vite.cli.config.ts",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.6",
    "@opencode/theme": "^2.2.6",
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "@types/node": "^24.0.0",
    "electron": "^45.2.3",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vite-plugin-solid": "^2.11.15"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "rate-limit",
    "usage-limit",
    "fallback",
    "model-fallback",
    "llm-routing",
    "claude",
    "claude-code",
    "chatgpt",
    "codex",
    "github-copilot",
    "grok",
    "xai",
    "anthropic",
    "openai",
    "ollama",
    "quota",
    "ai-coding",
    "dashboard"
  ],
  "license": "MIT",
  "overrides": {
    "glob": "^14.0.2",
    "minimatch": "^11.0.1"
  },
  "author": "aicowboi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aicowboi/opencode-quota-router.git"
  },
  "homepage": "https://github.com/aicowboi/opencode-quota-router#readme",
  "bugs": {
    "url": "https://github.com/aicowboi/opencode-quota-router/issues"
  }
}
